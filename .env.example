JWT_SECRET=generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
MONGO_URI=mongodb://localhost:27017/auth_db
GATEWAY_PORT=4000
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
WEB_ORIGIN=http://localhost:3000
CONTENT_MONGO_URI=mongodb://localhost:27017/content_db
CONTENT_SERVICE_HOST=127.0.0.1
CONTENT_SERVICE_PORT=4002
SCHEDULER_MONGO_URI=mongodb://localhost:27017/schedule_db
SCHEDULER_SERVICE_HOST=127.0.0.1
SCHEDULER_SERVICE_PORT=4003
MAX_UPCOMING_BOOKINGS=10
AI_MONGO_URI=mongodb://localhost:27017/interview_db
AI_HTTP_PORT=4004
AI_SERVICE_HOST=127.0.0.1
AI_SERVICE_PORT=4014
REDIS_URL=redis://localhost:6379
# Leave GEMINI_API_KEY empty to run the AI interviewer in demo mode. Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MAX_SESSIONS_PER_DAY=5
PUBLIC_URL=http://localhost

# First administrator, created on startup. Use a strong password and remove it from the file after first login.
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=
ADMIN_PHONE=+15550000000
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=true
